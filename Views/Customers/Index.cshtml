@model IEnumerable<web2.Models.Customer>

<a asp-controller="Customers" asp-action="Create">新增客戶</a>
<!-- <a href="/Customers/Create">新增客戶</a> -->

<hr />
<form action="/Customers/Index" method="get">
  <input type="text" name="searchKeywords" />
  <button type="submit">搜尋</button>
</form>
<hr />

<table border=1>
  <thead>
    <tr>
      <th>姓名</th>
      <th>生日</th>
      <th>照片</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var customer in Model)
    {
      <tr>
        <td>@customer.Name</td>
        <td>@customer.Birthdate.ToShortDateString()</td>
        <td><img src="@customer.Photo" alt="Customer Photo" width="100" /></td>
        <td>
          <a asp-controller="Customers" asp-action="Edit" asp-route-id="@customer.CustomerID">編輯</a>
          <!-- <a href="/Customers/Edit/@customer.CustomerID">編輯</a> -->
          @* 刪除改用 form 送出 POST；form 標籤協助程式會自動附上 anti-forgery token。 *@
          <form asp-controller="Customers" asp-action="Delete" asp-route-id="@customer.CustomerID" method="post"
                style="display:inline" onsubmit="return confirm('確定要刪除 @customer.Name 嗎？')">
            <button type="submit">刪除</button>
          </form>
        </td>
      </tr>
    }
  </tbody>
</table>
